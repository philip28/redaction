# ---------------------------------------------------------------- LLM
# Any OpenAI-compatible /chat/completions endpoint: vLLM, Ollama, LM Studio,
# llama.cpp server, an internal gateway, or api.openai.com/v1.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# How the key is sent. Defaults below are the OpenAI convention:
#   Authorization: Bearer <key>
# For a gateway that expects a raw key header, use:
#   LLM_AUTH_HEADER=X-API-Key
#   LLM_AUTH_SCHEME=
# Azure OpenAI uses LLM_AUTH_HEADER=api-key with an empty scheme.
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer
LLM_MODEL=qwen2.5:14b-instruct
LLM_TIMEOUT=180
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
# Characters of document text per request. Lower it for small context windows.
LLM_MAX_CHUNK_CHARS=9000
LLM_CONCURRENCY=3
LLM_MAX_RETRIES=2
# Set true only if the endpoint supports response_format={"type":"json_object"}.
LLM_JSON_MODE=false
# Raw JSON merged into every request header, e.g. {"X-Tenant":"audit"}
LLM_EXTRA_HEADERS={}

# ---------------------------------------------------------------- detection
ENTITY_CATEGORIES=PERSON,ORG,LOCATION,EMAIL,PHONE,URL,ID_NUMBER,ACCOUNT,SYSTEM,OTHER
# Deterministic detectors that run with or without the LLM.
RULE_DETECTORS=EMAIL,PHONE,URL,INN,OGRN,SNILS,IBAN,CARD
# Categories that match Russian inflected forms by default (Иванов -> Иванова).
INFLECT_CATEGORIES=PERSON
CASE_SENSITIVE=true

# ---------------------------------------------------------------- tags
TAG_PREFIX=[[
TAG_SUFFIX=]]

# ---------------------------------------------------------------- storage
DATA_DIR=./data
JOB_TTL_MINUTES=240
MAX_UPLOAD_MB=50
MAX_FILES_PER_JOB=25
# Clear document authors, last-modified-by and comment/revision names.
SCRUB_METADATA=true
REDACTED_SUFFIX=__redacted
RESTORED_SUFFIX=__restored

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
